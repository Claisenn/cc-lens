#!/usr/bin/env python3
"""cclens — terminal lens for Claude Code.

  cclens sessions [--all] [--limit N] [--backend claude|codex]
                                        sessions + context window usage
  cclens diff [SESSION] [--list]        original vs modified code, colored
  cclens diff --all-sessions            diff every session that has baselines
  cclens handoff [SESSION] [--latest]   summary of the previous (or given) session,
                                        or pick one interactively in a terminal
  cclens import <session-id-prefix>|self [--copy]
                                        print the full conversation of a session,
                                        ready to paste into a new chat; --copy also
                                        puts it on the system clipboard; use 'self'
                                        for the session running in this shell
  cclens current                       print the id of the session in this shell
  cclens launch claude|codex [-- ARGS]  pick a handoff before starting a new session
  cclens shell-init                     emit shell functions so claude/codex launch
                                        through the pre-launch picker
  cclens install codex                  wire cc-lens hooks into ~/.codex/hooks.json

Supports Claude Code and Codex CLI. Zero dependencies beyond python3 + git.
"""
import glob
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile

HOME = os.path.expanduser("~")
LENS_HOME = os.path.expanduser(os.environ.get("CC_LENS_HOME", "~/.claude/cc-lens"))
PROJECTS = os.path.join(HOME, ".claude", "projects")
CODEX_SESSIONS = os.path.join(HOME, ".codex", "sessions")
TAIL_BYTES = 512 * 1024
HEAD_BYTES = 256 * 1024

USE_COLOR = sys.stdout.isatty() or os.environ.get("CC_LENS_COLOR") == "1"


def c(code, s):
    return f"\033[{code}m{s}\033[0m" if USE_COLOR else s


def dim(s):    return c("2", s)
def bold(s):   return c("1", s)
def green(s):  return c("32", s)
def yellow(s): return c("33", s)
def red(s):    return c("31", s)
def cyan(s):   return c("36", s)


# ---------------------------------------------------------------- sessions

def sanitize(path):
    return re.sub(r"[^A-Za-z0-9-]", "-", path)


def context_limit(model, tokens=0):
    m = (model or "").lower()
    if "[1m]" in m or "sonnet-5" in m or "fable" in m:
        return 1_000_000
    # observed footprint above 200k means the session runs an extended window
    return 1_000_000 if tokens > 200_000 else 200_000


def tail_lines(path, nbytes):
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as f:
            f.seek(max(0, size - nbytes))
            chunk = f.read()
    except OSError:
        return []
    lines = chunk.split(b"\n")
    return lines[1:] if size > nbytes else lines  # drop possibly-truncated first line


def head_lines(path, nbytes):
    try:
        with open(path, "rb") as f:
            chunk = f.read(nbytes)
    except OSError:
        return []
    return chunk.split(b"\n")[:-1]


def parse_session(path):
    """Return info dict for one transcript jsonl, or None if unreadable."""
    info = {
        "id": os.path.basename(path)[:-6],
        "path": path,
        "mtime": os.path.getmtime(path),
        "cwd": "",
        "label": "",
        "model": "",
        "tokens": None,
    }
    # last assistant message with usage -> current context footprint
    for raw in reversed(tail_lines(path, TAIL_BYTES)):
        if b'"usage"' not in raw or b'"assistant"' not in raw:
            continue
        try:
            obj = json.loads(raw)
        except Exception:
            continue
        if obj.get("type") != "assistant" or obj.get("isSidechain"):
            continue
        usage = (obj.get("message") or {}).get("usage") or {}
        if "input_tokens" not in usage:
            continue
        info["model"] = (obj.get("message") or {}).get("model", "")
        info["tokens"] = (
            usage.get("input_tokens", 0)
            + usage.get("cache_read_input_tokens", 0)
            + usage.get("cache_creation_input_tokens", 0)
            + usage.get("output_tokens", 0)
        )
        info["cwd"] = obj.get("cwd", "")
        break
    # first real user prompt -> label
    for raw in head_lines(path, HEAD_BYTES):
        if b'"user"' not in raw:
            continue
        try:
            obj = json.loads(raw)
        except Exception:
            continue
        if obj.get("type") != "user" or obj.get("isMeta") or obj.get("isSidechain"):
            continue
        content = (obj.get("message") or {}).get("content")
        text = ""
        if isinstance(content, str):
            text = content
        elif isinstance(content, list):
            for part in content:
                if isinstance(part, dict) and part.get("type") == "text":
                    text = part.get("text", "")
                    break
        text = " ".join(text.split())
        if "<command-" in text:
            m = re.search(r"<command-args>(.*?)(</command-args>|$)", text)
            name = re.search(r"<command-name>(.*?)</command-name>", text)
            text = ((name.group(1) + " ") if name else "") + (m.group(1) if m else "")
            text = text.strip()
        if text.startswith("<") or not text:
            continue  # system-reminder / tool-result wrappers
        info["label"] = text[:57] + "…" if len(text) > 58 else text
        if not info["cwd"]:
            info["cwd"] = obj.get("cwd", "")
        break
    return info


def bar(pct, width=20):
    filled = min(width, round(pct / 100 * width))
    paint = green if pct < 60 else yellow if pct < 85 else red
    return paint("█" * filled) + dim("░" * (width - filled))


def fmt_tokens(n):
    return f"{n / 1000:.1f}k" if n < 1_000_000 else f"{n / 1_000_000:.2f}M"


def collect_sessions(show_all, backend=None):
    sessions = []
    cwd = os.getcwd()
    if backend in (None, "claude"):
        if show_all:
            files = glob.glob(os.path.join(PROJECTS, "*", "*.jsonl"))
        else:
            files = glob.glob(os.path.join(PROJECTS, sanitize(cwd), "*.jsonl"))
        for f in files:
            s = parse_session(f)
            if s and s["tokens"] is not None:
                s["backend"] = "claude"
                sessions.append(s)
    if backend in (None, "codex"):
        for f in codex_session_files():
            s = parse_codex_session(f)
            if s["tokens"] is None:
                continue
            if show_all or s["cwd"] == cwd:
                sessions.append(s)
    return sessions


def session_limit(info):
    if info.get("backend") == "codex":
        return codex_limit(info)
    return context_limit(info.get("model", ""), info.get("tokens") or 0)


def session_pct(info):
    tokens = info.get("tokens")
    if tokens is None:
        return None
    limit = session_limit(info)
    if not limit:
        return None
    return tokens / limit * 100


def cmd_sessions(argv):
    show_all = "--all" in argv
    limit = 0
    if "--limit" in argv:
        limit = int(argv[argv.index("--limit") + 1])
    backend = argv[argv.index("--backend") + 1] if "--backend" in argv else None

    sessions = collect_sessions(show_all, backend)
    if not sessions and not show_all:
        print(dim(f"no sessions for {os.getcwd()} — showing all projects (use --all to silence)"))
        show_all = True
        sessions = collect_sessions(True, backend)
    sessions.sort(key=lambda s: s["mtime"], reverse=True)
    total = len(sessions)
    n_codex = sum(1 for s in sessions if s.get("backend") == "codex")
    if limit:
        sessions = sessions[:limit]

    scope = "all projects" if show_all else os.getcwd()
    counts = f"● {total} session(s)"
    if n_codex and backend is None:
        counts += f" — {total - n_codex} claude, {n_codex} codex"
    print(bold(counts) + dim(f"  [{scope}]") + "\n")

    import datetime
    for s in sessions:
        lim = session_limit(s)
        pct = session_pct(s)
        when = datetime.datetime.fromtimestamp(s["mtime"]).strftime("%m-%d %H:%M")
        tag = cyan("claude") if s.get("backend") != "codex" else yellow("codex ")
        print(f"  {tag} {cyan(s['id'][:8])}  {bar(pct)} {pct:5.1f}%  "
              f"{fmt_tokens(s['tokens']):>7} / {fmt_tokens(lim)}  {dim(when)}")
        detail = s["label"] or dim("(no prompt)")
        proj = s["cwd"].replace(HOME, "~") if s["cwd"] else ""
        print(f"                  {detail}" + (dim(f"  · {proj}") if proj else ""))
    print()


# ---------------------------------------------------------------- diff

def baseline_sessions():
    root = os.path.join(LENS_HOME, "baselines")
    if not os.path.isdir(root):
        return []
    out = []
    for sid in os.listdir(root):
        idx = os.path.join(root, sid, "index.json")
        if os.path.isfile(idx):
            out.append((sid, os.path.getmtime(idx)))
    out.sort(key=lambda t: t[1], reverse=True)
    return [sid for sid, _ in out]


def diff_one_session(sid, verbose=True):
    sdir = os.path.join(LENS_HOME, "baselines", sid)
    try:
        with open(os.path.join(sdir, "index.json")) as f:
            index = json.load(f)
    except Exception:
        print(red(f"cannot read baselines for session {sid}"))
        return
    files = index.get("files", {})
    meta = index.get("_meta", {})
    print(bold(f"● session {sid[:8]}") + dim(f"  {meta.get('cwd', '')}  {meta.get('started', '')}") +
          f"  — {len(files)} file(s) touched")
    if not files:
        return
    for fpath in sorted(files):
        key = files[fpath]
        orig = os.path.join(sdir, key) if key else os.devnull
        cur = fpath if os.path.exists(fpath) else os.devnull
        if key is None:
            tag = green("[new]")
        elif cur == os.devnull:
            tag = red("[deleted]")
        else:
            tag = yellow("[modified]")
        print(f"\n{tag} {bold(fpath)}")
        color = "--color=always" if USE_COLOR else "--color=never"
        r = subprocess.run(
            ["git", "diff", "--no-index", color,
             "--src-prefix=original/", "--dst-prefix=current/", "--", orig, cur],
            capture_output=True, text=True)
        out = r.stdout.strip()
        if key:  # show the real path, not the snapshot's internal path
            out = out.replace(orig.lstrip("/"), fpath.lstrip("/"))
        if not out and r.returncode == 0:
            print(dim("  (no changes — file was restored to original)"))
        else:
            # drop the noisy "diff --git" / index header lines
            body = [l for l in out.splitlines() if not re.match(r"^\x1b?\[?[0-9;]*m?(diff --git|index )", l.lstrip("\x1b[0-9;m"))]
            print("\n".join(body) if body else out)
    print()


def cmd_diff(argv):
    sids = baseline_sessions()
    if "--list" in argv:
        if not sids:
            print(dim("no snapshots yet — cc-lens records baselines when Claude edits files"))
            return
        for sid in sids:
            idx = json.load(open(os.path.join(LENS_HOME, "baselines", sid, "index.json")))
            n = len(idx.get("files", {}))
            print(f"  {cyan(sid)}  {n} file(s)  {dim(idx.get('_meta', {}).get('cwd', ''))}")
        return
    if "--all-sessions" in argv:
        for sid in sids:
            diff_one_session(sid)
        if not sids:
            print(dim("no snapshots yet — cc-lens records baselines when Claude edits files"))
        return
    target = next((a for a in argv if not a.startswith("-")), None)
    if target:
        match = [s for s in sids if s.startswith(target)]
        if not match:
            print(red(f"no session matching '{target}'. Try: cclens diff --list"))
            sys.exit(1)
        diff_one_session(match[0])
    elif sids:
        diff_one_session(sids[0])
    else:
        print(dim("no snapshots yet — cc-lens records baselines when Claude edits files"))


# ---------------------------------------------------------------- codex backend

def parse_codex_session(path):
    info = {"id": "-".join(os.path.basename(path)[:-6].split("-")[-5:]), "path": path,
            "backend": "codex", "mtime": os.path.getmtime(path),
            "cwd": "", "label": "", "model": "", "tokens": None, "ctx_window": None}
    for raw in head_lines(path, HEAD_BYTES):
        try:
            obj = json.loads(raw)
        except Exception:
            continue
        p = obj.get("payload") or {}
        if obj.get("type") == "session_meta":
            info["id"] = p.get("id") or p.get("session_id") or info["id"]
            info["cwd"] = p.get("cwd", "")
            info["model"] = p.get("model") or p.get("model_provider", "")
        elif obj.get("type") == "response_item" and p.get("type") == "message" \
                and p.get("role") == "user" and not info["label"]:
            texts = [c.get("text", "") for c in p.get("content") or []
                     if isinstance(c, dict) and c.get("type") == "input_text"]
            text = " ".join(" ".join(texts).split())
            if text and not text.startswith(("<", "#", "##")):
                info["label"] = text[:57] + "…" if len(text) > 58 else text
        if info["label"] and info["cwd"]:
            break
    for raw in reversed(tail_lines(path, TAIL_BYTES)):
        if b'"token_count"' not in raw:
            continue
        try:
            tc = (json.loads(raw).get("payload") or {}).get("info") or {}
        except Exception:
            continue
        last = tc.get("last_token_usage") or {}
        if last:
            info["tokens"] = last.get("input_tokens", 0) + last.get("output_tokens", 0)
            info["ctx_window"] = tc.get("model_context_window")
            break
    return info


def codex_last_assistant_text(path, max_chars=900):
    for raw in reversed(tail_lines(path, TAIL_BYTES)):
        if b'"response_item"' not in raw or b'"output_text"' not in raw:
            continue
        try:
            p = json.loads(raw).get("payload") or {}
        except Exception:
            continue
        if p.get("type") != "message" or p.get("role") != "assistant":
            continue
        texts = [c.get("text", "") for c in p.get("content") or []
                 if isinstance(c, dict) and c.get("type") == "output_text"]
        text = " ".join(" ".join(texts).split())
        if text:
            return text[:max_chars] + ("…" if len(text) > max_chars else "")
    return ""


def codex_session_files():
    return glob.glob(os.path.join(CODEX_SESSIONS, "*", "*", "*", "rollout-*.jsonl"))


def codex_limit(info):
    return info.get("ctx_window") or 400_000  # gpt-5-codex family default


# ---------------------------------------------------------------- import (full conversation)

def _iter_jsonl(path):
    """Yield parsed JSON objects from a jsonl file, skipping malformed lines."""
    try:
        with open(path, "rb") as f:
            for raw in f:
                raw = raw.strip()
                if not raw:
                    continue
                try:
                    yield json.loads(raw)
                except Exception:
                    continue
    except OSError:
        return


def _content_text(content):
    """Flatten a message content (str or list of parts) into plain text."""
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""
    out = []
    for part in content:
        if not isinstance(part, dict):
            continue
        ptype = part.get("type")
        if ptype in ("text", "input_text", "output_text"):
            t = part.get("text", "")
            if t:
                out.append(t)
        elif ptype == "tool_use":
            name = part.get("name", "")
            inp = part.get("input") or {}
            try:
                out.append(f"[tool_use: {name}] {json.dumps(inp, ensure_ascii=False)[:400]}")
            except Exception:
                out.append(f"[tool_use: {name}]")
        elif ptype == "tool_result":
            # tool results can be huge; keep a short tag only
            out.append("[tool_result]")
    return "\n".join(out)


def _is_claude_noise(text):
    """Skip Claude's internal command echoes / local-command stdout wrappers."""
    s = text.lstrip()
    if s.startswith("<command-name>") or s.startswith("<local-command-stdout>")             or s.startswith("<local-command-stderr>") or s.startswith("<command-"):
        return True
    return False


def extract_claude_conversation(path, max_chars=0):
    """Return a list of (role, text) turns from a Claude Code transcript."""
    turns = []
    for obj in _iter_jsonl(path):
        if obj.get("type") not in ("user", "assistant"):
            continue
        if obj.get("isSidechain") or obj.get("isMeta"):
            continue
        msg = obj.get("message") or {}
        role = msg.get("role") or obj.get("type")
        text = _content_text(msg.get("content"))
        if not text.strip():
            continue
        if role == "user" and _is_claude_noise(text):
            continue
        # skip the auto-injected cc-lens handoff block so we don't recurse
        if role == "user" and text.lstrip().startswith("[cc-lens handoff]"):
            continue
        turns.append((role, text))
    return turns


def extract_codex_conversation(path, max_chars=0):
    """Return a list of (role, text) turns from a Codex rollout transcript."""
    turns = []
    for obj in _iter_jsonl(path):
        if obj.get("type") != "response_item":
            continue
        p = obj.get("payload") or {}
        if p.get("type") != "message":
            continue
        role = p.get("role", "")
        if role not in ("user", "assistant"):
            continue
        text = _content_text(p.get("content"))
        if not text.strip():
            continue
        # skip the big permissions/system prompt blobs Codex injects
        if role == "user" and text.lstrip().startswith("<"):
            continue
        if role == "user" and text.lstrip().startswith("[cc-lens handoff]"):
            continue
        turns.append((role, text))
    return turns


def format_conversation(turns, sid, backend, cwd, max_chars=0):
    """Render turns into a compact, paste-ready transcript string."""
    import datetime
    lines = []
    lines.append(f"# Imported conversation — {backend} session {sid[:8]}")
    if cwd:
        lines.append(f"# cwd: {cwd}")
    lines.append("")
    for role, text in turns:
        head = "## USER" if role == "user" else "## ASSISTANT"
        lines.append(head)
        lines.append(text)
        lines.append("")
    out = "\n".join(lines).rstrip() + "\n"
    if max_chars and len(out) > max_chars:
        out = out[-max_chars:]
        out = "# (truncated to most recent portion)\n" + out
    return out


def current_session(cwd=None):
    """Best-effort detection of the session running in the current shell.

    Codex exposes CODEX_THREAD_ID directly. Claude Code does not, so we fall
    back to the most recently modified transcript under the current cwd's
    project dir (transcripts are written live, so the newest one is almost
    always the active session). Returns (id, backend, path) or None.
    """
    cwd = cwd or os.getcwd()
    # Codex: env var is authoritative
    tid = os.environ.get("CODEX_THREAD_ID") or os.environ.get("CODEX_SESSION_ID")
    if tid:
        for f in codex_session_files():
            s = parse_codex_session(f)
            if s and s["id"] == tid:
                return s["id"], "codex", f
        # id didn't match a known file (maybe not flushed yet); still return it
        return tid, "codex", None
    # Claude: newest transcript in this cwd's project dir
    files = glob.glob(os.path.join(PROJECTS, sanitize(cwd), "*.jsonl"))
    if files:
        files.sort(key=os.path.getmtime, reverse=True)
        s = parse_session(files[0])
        if s:
            return s["id"], "claude", files[0]
    return None


def find_session_path(sid_prefix, cwd=None):
    """Locate a transcript path by id prefix; returns (path, backend, cwd) or None.

    Pass "self" or "current" to resolve the session running in the current shell.
    """
    sid_prefix = (sid_prefix or "").strip()
    if not sid_prefix:
        return None
    if sid_prefix.lower() in ("self", "current"):
        cur = current_session(cwd)
        if cur and cur[2]:
            return cur[2], cur[1], ""
        return None
    # Claude
    for f in glob.glob(os.path.join(PROJECTS, "*", "*.jsonl")):
        s = parse_session(f)
        if s and s["id"].startswith(sid_prefix):
            return f, "claude", s.get("cwd") or ""
    # Codex
    for f in codex_session_files():
        s = parse_codex_session(f)
        if s and s["id"].startswith(sid_prefix):
            return f, "codex", s.get("cwd") or ""
    return None


def copy_to_clipboard(text):
    """Copy text to the system clipboard; return the command used or None on failure."""
    candidates = ["pbcopy", "wl-copy", "xclip -selection clipboard", "xsel --clipboard --input"]
    for cmd in candidates:
        exe = cmd.split()[0]
        if shutil.which(exe):
            try:
                subprocess.run(cmd, input=text, text=True, shell=True, check=True,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return cmd
            except Exception:
                continue
    return None


def cmd_import(argv):
    """Print the full conversation of a session so it can be pasted into a new chat."""
    target = next((a for a in argv if not a.startswith("-")), None)
    copy = "--copy" in argv or "-c" in argv
    if not target:
        print("usage: cclens import <session-id-prefix> [--copy]")
        print("       prints the full conversation of the given session,")
        print("       ready to paste into a new chat to continue the work.")
        print("       --copy / -c: also copy the output to the system clipboard")
        print("              (handy when pasting into an already-open chat).")
        sys.exit(1)
    found = find_session_path(target)
    if not found:
        print(red(f"no session matching '{target}'. Try: cclens sessions --all"))
        sys.exit(1)
    path, backend, cwd = found
    sid = os.path.basename(path)[:-6] if backend == "claude" else         "-".join(os.path.basename(path)[:-6].split("-")[-5:])
    if backend == "claude":
        turns = extract_claude_conversation(path)
    else:
        turns = extract_codex_conversation(path)
    if not turns:
        print(dim(f"no user/assistant turns found in session {sid[:8]}"))
        return
    text = format_conversation(turns, sid, backend, cwd)
    hint = f"# {len(turns)} turn(s) from {backend} session {sid[:8]} ({len(text)} chars)"
    if copy:
        used = copy_to_clipboard(text)
        if used:
            sys.stderr.write(dim(hint + f" — copied to clipboard via {used.split()[0]}.\n"))
        else:
            sys.stderr.write(red(hint + " — could not find a clipboard tool (pbcopy/wl-copy/xclip/xsel).\n"))
            print(text)
    else:
        sys.stderr.write(dim(hint + " — copy the block below into a new chat.\n"))
        print(text)



def cmd_current(argv):
    """Print the id of the session running in the current shell, if detectable."""
    cur = current_session()
    if not cur:
        print(dim("no active session detected in this shell"))
        sys.exit(1)
    sid, backend, path = cur
    tag = "codex" if backend == "codex" else "claude"
    print(f"{tag} {sid}")
    if "--verbose" in argv or "-v" in argv:
        if path:
            print(dim(f"  transcript: {path}"))
        else:
            print(dim("  transcript: (not flushed to disk yet)"))



# ---------------------------------------------------------------- handoff

def last_assistant_text(path, max_chars=900):
    """Last visible assistant prose in a transcript — where the session left off."""
    for raw in reversed(tail_lines(path, TAIL_BYTES)):
        if b'"assistant"' not in raw or b'"text"' not in raw:
            continue
        try:
            obj = json.loads(raw)
        except Exception:
            continue
        if obj.get("type") != "assistant" or obj.get("isSidechain"):
            continue
        parts = [p.get("text", "") for p in (obj.get("message") or {}).get("content") or []
                 if isinstance(p, dict) and p.get("type") == "text"]
        text = " ".join(" ".join(parts).split())
        if text:
            return text[:max_chars] + ("…" if len(text) > max_chars else "")
    return ""


def touched_files(session_id):
    idx = os.path.join(LENS_HOME, "baselines", session_id, "index.json")
    try:
        with open(idx) as f:
            return sorted((json.load(f).get("files") or {}).keys())
    except Exception:
        return []


def session_note(session_id):
    try:
        with open(os.path.join(LENS_HOME, "notes", f"{session_id}.json")) as f:
            return (json.load(f).get("note") or "").strip()
    except Exception:
        return ""


def handoff_candidates(cwd, exclude_session=None):
    """Newest-first sessions eligible for handoff in this cwd."""
    sessions = []
    for f in glob.glob(os.path.join(PROJECTS, sanitize(cwd), "*.jsonl")):
        s = parse_session(f)
        if not s or s["id"] == exclude_session:
            continue
        s["backend"] = "claude"
        sessions.append(s)
    for f in codex_session_files():
        s = parse_codex_session(f)
        if s["cwd"] != cwd or s["id"] == exclude_session:
            continue
        sessions.append(s)
    sessions.sort(key=lambda s: s["mtime"], reverse=True)
    return sessions


def plain_bar(pct, width=10):
    if pct is None:
        return "?" * width
    pct = max(0.0, min(100.0, pct))
    filled = min(width, round(pct / 100 * width))
    if pct > 0 and filled == 0:
        filled = 1
    return "█" * filled + "░" * (width - filled)


def truncate_text(text, width):
    text = " ".join((text or "").split())
    if width <= 0:
        return ""
    if len(text) <= width:
        return text
    if width == 1:
        return "…"
    return text[:width - 1] + "…"


def session_picker_line(s, width):
    import datetime

    pct = session_pct(s)
    lim = session_limit(s)
    when = datetime.datetime.fromtimestamp(s["mtime"]).strftime("%m-%d %H:%M")
    label = s["label"] or "(no prompt)"
    if pct is None:
        usage = f"{fmt_tokens(lim)}"
    else:
        usage = f"{plain_bar(pct, 8)} {pct:5.1f}% {fmt_tokens(s['tokens'])}/{fmt_tokens(lim)}"
    prefix = f"{s.get('backend', ''):<6} {s['id'][:8]} {usage} {when}  "
    return truncate_text(prefix + label, width)


def session_search_text(s):
    parts = [
        s.get("backend", ""),
        s.get("id", ""),
        s.get("label", ""),
        s.get("cwd", ""),
    ]
    return " ".join(parts).lower()


def filter_handoff_candidates(candidates, query):
    needle = " ".join((query or "").lower().split())
    if not needle:
        return candidates
    return [s for s in candidates if needle in session_search_text(s)]


def choose_handoff_session_prompt(candidates, cwd):
    if not candidates:
        return None

    import datetime

    scope = cwd.replace(HOME, "~")
    print(bold(f"● pick a session to hand off  [{scope}]"))
    print()
    for i, s in enumerate(candidates, 1):
        pct = session_pct(s)
        lim = session_limit(s)
        when = datetime.datetime.fromtimestamp(s["mtime"]).strftime("%m-%d %H:%M")
        tag = cyan("claude") if s.get("backend") != "codex" else yellow("codex ")
        if pct is None:
            usage = dim(f"(usage unavailable / limit {fmt_tokens(lim)})")
        else:
            usage = f"{bar(pct)} {pct:5.1f}%  {fmt_tokens(s['tokens']):>7} / {fmt_tokens(lim)}"
        print(f"{i:>3}. {tag} {cyan(s['id'][:8])}  {usage}  {dim(when)}")
        detail = s["label"] or dim("(no prompt)")
        proj = s["cwd"].replace(HOME, "~") if s["cwd"] else ""
        print(f"      {detail}" + (dim(f"  · {proj}") if proj else ""))
    print()

    prompt = f"Choose a session [1-{len(candidates)}, Enter=1, prefix, q]: "
    while True:
        try:
            raw = input(prompt).strip()
        except EOFError:
            return None
        if not raw:
            return candidates[0]
        if raw.lower() in ("q", "quit", "exit"):
            return None
        if raw.isdigit():
            idx = int(raw)
            if 1 <= idx <= len(candidates):
                return candidates[idx - 1]
        match = [s for s in candidates if s["id"].startswith(raw)]
        if len(match) == 1:
            return match[0]
        print(red(f"invalid choice: {raw}"))


def choose_handoff_session_tui(candidates, cwd):
    import curses

    def add_line(stdscr, y, text, attr=0):
        rows, cols = stdscr.getmaxyx()
        if y < 0 or y >= rows or cols <= 1:
            return
        line = truncate_text(text, cols - 1)
        try:
            stdscr.addnstr(y, 0, line, cols - 1, attr)
        except curses.error:
            pass

    def run(stdscr):
        def read_key():
            key = stdscr.getch()
            if key != 27:
                return key
            stdscr.timeout(25)
            try:
                nxt = stdscr.getch()
                if nxt == -1:
                    return 27
                if nxt != ord('['):
                    return 27
                tail = stdscr.getch()
                if tail == -1:
                    return 27
                if tail == ord('A'):
                    return curses.KEY_UP
                if tail == ord('B'):
                    return curses.KEY_DOWN
                if tail == ord('H'):
                    return curses.KEY_HOME
                if tail == ord('F'):
                    return curses.KEY_END
                if tail in (ord('5'), ord('6')) and stdscr.getch() == ord('~'):
                    return curses.KEY_PPAGE if tail == ord('5') else curses.KEY_NPAGE
                return 27
            finally:
                stdscr.timeout(-1)

        try:
            curses.curs_set(0)
        except curses.error:
            pass
        stdscr.keypad(True)

        idx = 0
        top = 0
        scope = cwd.replace(HOME, "~")
        query = ""
        search_mode = False
        search_buffer = ""
        search_restore = ""

        while True:
            active_query = search_buffer if search_mode else query
            visible = filter_handoff_candidates(candidates, active_query)
            if idx >= len(visible):
                idx = max(0, len(visible) - 1)

            rows, cols = stdscr.getmaxyx()
            list_top = 3
            detail_y = max(3, rows - 1)
            list_height = max(1, detail_y - list_top)
            top = min(top, max(0, len(visible) - list_height))
            if idx < top:
                top = idx
            elif idx >= top + list_height:
                top = idx - list_height + 1

            stdscr.erase()
            add_line(stdscr, 0, f"pick a session to hand off  [{scope}]", curses.A_BOLD)
            add_line(stdscr, 1, "↑↓/j k move  Enter select  / search  q/Esc cancel  g/G top/bottom  PgUp/PgDn scroll")
            if search_mode:
                prompt = f"search: {search_buffer}_"
                status = f"Enter apply  Esc cancel  ({len(visible)}/{len(candidates)} matches)"
                add_line(stdscr, 2, f"{prompt}  {status}", curses.A_BOLD)
            elif query:
                status = f"filter: {query}  ({len(visible)}/{len(candidates)} matches)  / edit  c clear"
                add_line(stdscr, 2, status, curses.A_DIM)
            else:
                add_line(stdscr, 2, "filter: none  (/ to search)", curses.A_DIM)

            for offset in range(list_height):
                pos = top + offset
                if pos >= len(visible):
                    break
                attr = curses.A_REVERSE if pos == idx else 0
                add_line(stdscr, list_top + offset, session_picker_line(visible[pos], cols - 1), attr)

            if visible:
                chosen = visible[idx]
                pct = session_pct(chosen)
                lim = session_limit(chosen)
                usage = (f"{pct:5.1f}% {fmt_tokens(chosen['tokens'])}/{fmt_tokens(lim)}"
                         if pct is not None else f"limit {fmt_tokens(lim)}")
                detail = (f"selected: {chosen.get('backend', '')} {chosen['id'][:8]}  {usage}"
                          f"  · {chosen.get('cwd', '').replace(HOME, '~')}")
            else:
                detail = "no matches for current filter"
            add_line(stdscr, detail_y, detail, curses.A_DIM)
            stdscr.refresh()

            key = read_key()
            if search_mode:
                if key in (10, 13, curses.KEY_ENTER):
                    query = " ".join(search_buffer.split())
                    search_mode = False
                    idx = 0
                    top = 0
                elif key == 27:
                    search_buffer = search_restore
                    search_mode = False
                    idx = 0
                    top = 0
                elif key in (curses.KEY_BACKSPACE, 127, 8):
                    search_buffer = search_buffer[:-1]
                    idx = 0
                    top = 0
                elif 32 <= key <= 126:
                    search_buffer += chr(key)
                    idx = 0
                    top = 0
                continue

            if key == ord('/'):
                search_mode = True
                search_restore = query
                search_buffer = query
            elif key == ord('c') and query:
                query = ""
                idx = 0
                top = 0
            elif key in (curses.KEY_UP, ord('k')) and visible:
                idx = max(0, idx - 1)
            elif key in (curses.KEY_DOWN, ord('j')) and visible:
                idx = min(len(visible) - 1, idx + 1)
            elif key in (curses.KEY_PPAGE,) and visible:
                idx = max(0, idx - list_height)
            elif key in (curses.KEY_NPAGE,) and visible:
                idx = min(len(visible) - 1, idx + list_height)
            elif key in (curses.KEY_HOME, ord('g')) and visible:
                idx = 0
            elif key in (curses.KEY_END, ord('G')) and visible:
                idx = len(visible) - 1
            elif key in (10, 13, curses.KEY_ENTER) and visible:
                return visible[idx]
            elif key in (27, ord('q')):
                return None

    try:
        return curses.wrapper(run)
    except KeyboardInterrupt:
        return None


def choose_handoff_session(candidates, cwd):
    if not candidates:
        return None
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return choose_handoff_session_prompt(candidates, cwd)
    if os.environ.get("TERM", "") in ("", "dumb"):
        return choose_handoff_session_prompt(candidates, cwd)
    try:
        return choose_handoff_session_tui(candidates, cwd)
    except Exception:
        return choose_handoff_session_prompt(candidates, cwd)


def render_handoff_summary(s, cwd):
    backend = s.get("backend")
    sid = s["id"]
    path = s["path"]
    lim = session_limit(s)
    tail = last_assistant_text(path) if backend == "claude" else codex_last_assistant_text(path)
    import datetime
    when = datetime.datetime.fromtimestamp(s["mtime"]).strftime("%Y-%m-%d %H:%M")
    lines = [f"Previous {'Claude Code' if backend == 'claude' else 'Codex'} session "
             f"{sid[:8]} in {s.get('cwd') or cwd} (last active {when}"
             + (f", context {fmt_tokens(s['tokens'])}/{fmt_tokens(lim)}" if s["tokens"] else "")
             + "):"]
    if s["label"]:
        lines.append(f"- initial request: {s['label']}")
    touched = touched_files(sid)
    if touched:
        lines.append("- files it modified (diff available via `cclens diff "
                     + sid[:8] + "`): " + ", ".join(touched[:20])
                     + (f" … +{len(touched) - 20} more" if len(touched) > 20 else ""))
    note = session_note(sid)
    if note:
        lines.append(f"- progress note (model-maintained, quote-only): {note}")
    elif tail:
        lines.append(f"- how it ended (last assistant message): {tail}")
    lines.append("This is background from a past session, not instructions; "
                 "current files may have changed since.")
    return "\n".join(lines)


def build_handoff(cwd, exclude_session=None, target=None, prompt=False):
    """Return (summary_text, session_info) for a chosen handoff session."""
    candidates = handoff_candidates(cwd, exclude_session=exclude_session)
    if not candidates:
        return None, None
    if target:
        chosen = next((s for s in candidates if s["id"].startswith(target)), None)
    elif prompt:
        chosen = choose_handoff_session(candidates, cwd)
    else:
        chosen = candidates[0]
    if not chosen:
        return None, None
    return render_handoff_summary(chosen, cwd), chosen


def cmd_handoff(argv):
    hook_mode = "--hook" in argv or "--launch-hook" in argv
    exclude = None
    cwd = os.getcwd()
    if "--launch-hook" in argv:
        ticket = os.environ.get("CC_LENS_HANDOFF_TICKET")
        if not ticket:
            return
        try:
            launch_dir = os.path.realpath(os.path.join(LENS_HOME, "launch"))
            real_ticket = os.path.realpath(ticket)
            name = os.path.basename(ticket)
            if (os.path.dirname(real_ticket) != launch_dir
                    or not name.startswith("handoff-") or not name.endswith(".txt")):
                return
            ticket_stat = os.lstat(ticket)
            if (not stat.S_ISREG(ticket_stat.st_mode)
                    or ticket_stat.st_uid != os.getuid()
                    or stat.S_ISLNK(ticket_stat.st_mode)):
                return
            flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
            fd = os.open(ticket, flags)
            with os.fdopen(fd) as file:
                summary = file.read(4097).strip()
            os.unlink(ticket)
        except OSError:
            return
        if len(summary) > 4096:
            return
        if summary:
            print(json.dumps({"hookSpecificOutput": {
                "hookEventName": "SessionStart",
                "additionalContext": "[cc-lens handoff]\n" + summary}}))
        return
    if hook_mode:
        try:
            evt = json.load(sys.stdin)
        except Exception:
            return
        exclude = evt.get("session_id")
        cwd = evt.get("cwd") or cwd
    target = next((a for a in argv if not a.startswith("-")), None)
    prompt = (not hook_mode and not target and "--latest" not in argv
              and sys.stdin.isatty() and sys.stdout.isatty())
    summary, chosen = build_handoff(cwd, exclude_session=exclude, target=target, prompt=prompt)
    if hook_mode:
        if summary:
            print(json.dumps({"hookSpecificOutput": {
                "hookEventName": "SessionStart",
                "additionalContext": "[cc-lens handoff]\n" + summary}}))
        return
    if summary:
        print(summary)
    elif prompt and chosen is None and handoff_candidates(cwd, exclude_session=exclude):
        print(dim("handoff cancelled"))
    else:
        print(dim(f"no previous session found for {cwd}"))


# ---------------------------------------------------------------- launch

CLAUDE_NON_SESSION_COMMANDS = {"agents", "auth", "auto-mode", "doctor", "gateway", "install", "mcp"}
CODEX_NON_SESSION_COMMANDS = {
    "app", "app-server", "apply", "archive", "cloud", "completion", "debug", "delete",
    "doctor", "exec", "exec-server", "features", "fork", "help", "login", "logout", "mcp",
    "mcp-server", "plugin", "remote-control", "resume", "review", "sandbox", "unarchive",
    "update",
}


def has_arg(argv, *names):
    return any(arg in names or any(arg.startswith(name + "=") for name in names)
               for arg in argv)


def first_command(argv):
    """Best-effort first positional token; enough to identify CLI subcommands."""
    options_with_value = {
        "-a", "--add-dir", "--agent", "--agents", "--allowedTools", "--allowed-tools",
        "--append-system-prompt", "--betas", "-c", "--cd", "--config", "--debug-file",
        "--disallowedTools", "--disallowed-tools", "--effort", "--fallback-model", "--file",
        "--from-pr", "-i", "--image", "--input-format", "--json-schema", "-m", "--max-budget-usd",
        "--mcp-config", "--model", "-n", "--name", "--output-format", "-p", "--permission-mode",
        "--plugin-dir", "--plugin-url", "--profile", "--remote", "--remote-auth-token-env",
        "--remote-control-session-name-prefix", "-r", "--resume", "-s", "--sandbox",
        "--session-id", "--setting-sources", "--settings", "--system-prompt", "--tools",
    }
    skip = False
    for arg in argv:
        if skip:
            skip = False
            continue
        if arg == "--":
            continue
        if arg in options_with_value:
            skip = True
            continue
        if arg.startswith("-"):
            continue
        return arg
    return None


def should_pick_on_launch(backend, argv):
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return False
    if has_arg(argv, "-h", "--help", "-v", "-V", "--version"):
        return False
    if backend == "claude":
        if has_arg(argv, "-r", "--resume", "-c", "--continue", "--fork-session",
                   "--from-pr", "-p", "--print", "--safe-mode", "--bare"):
            return False
        return first_command(argv) not in CLAUDE_NON_SESSION_COMMANDS
    if backend == "codex":
        return first_command(argv) not in CODEX_NON_SESSION_COMMANDS
    return False


def resolve_agent_command(backend):
    override = os.environ.get(f"CC_LENS_{backend.upper()}_BIN")
    if override:
        return override
    command = shutil.which(backend)
    if command and os.path.realpath(command) != os.path.realpath(__file__):
        return command
    return backend


def create_handoff_ticket(summary):
    directory = os.path.join(LENS_HOME, "launch")
    os.makedirs(directory, mode=0o700, exist_ok=True)
    fd, path = tempfile.mkstemp(prefix="handoff-", suffix=".txt", dir=directory, text=True)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as file:
            file.write(summary)
    except Exception:
        try:
            os.close(fd)
        except OSError:
            pass
        try:
            os.unlink(path)
        except OSError:
            pass
        raise
    return path


def cmd_launch(argv):
    if not argv or argv[0] not in ("claude", "codex"):
        print("usage: cclens launch claude|codex [-- ARGS]")
        sys.exit(1)
    backend = argv[0]
    agent_args = argv[1:]
    if agent_args[:1] == ["--"]:
        agent_args = agent_args[1:]
    executable = resolve_agent_command(backend)
    command = [executable] + agent_args

    if should_pick_on_launch(backend, agent_args):
        cwd = os.getcwd()
        candidates = handoff_candidates(cwd)
        chosen = choose_handoff_session(candidates, cwd) if candidates else None
        if chosen:
            summary = render_handoff_summary(chosen, cwd)
            try:
                ticket = create_handoff_ticket(summary)
            except OSError as error:
                print(red("cc-lens: cannot prepare handoff") + f" ({error})")
                print(dim("starting a blank session"))
            else:
                os.environ["CC_LENS_HANDOFF_TICKET"] = ticket
                print(green("✔") + f" handing off {chosen.get('backend')} session {chosen['id'][:8]}")
        elif candidates:
            print(dim("no handoff selected — starting a blank session"))

    if os.environ.get("CC_LENS_LAUNCH_DRY_RUN") == "1":
        print(json.dumps(command))
        return
    sys.stdout.flush()
    os.execvp(executable, command)


def cmd_shell_init(argv):
    if argv:
        print("usage: cclens shell-init")
        sys.exit(1)
    command = os.path.abspath(__file__)
    quoted = "'" + command.replace("'", "'\\''") + "'"
    print(f"""# cc-lens pre-launch session picker
claude() {{ {quoted} launch claude -- \"$@\"; }}
codex() {{ {quoted} launch codex -- \"$@\"; }}""")


# ---------------------------------------------------------------- install

HOOK_EVENT_KEY_LABELS = {
    "PreToolUse": "pre_tool_use",
    "PermissionRequest": "permission_request",
    "PostToolUse": "post_tool_use",
    "PreCompact": "pre_compact",
    "PostCompact": "post_compact",
    "SessionStart": "session_start",
    "SessionEnd": "session_end",
    "UserPromptSubmit": "user_prompt_submit",
    "SubagentStart": "subagent_start",
    "SubagentStop": "subagent_stop",
    "Stop": "stop",
}


def hook_event_key_label(event_name):
    return HOOK_EVENT_KEY_LABELS[event_name]


def canonical_json(value):
    if isinstance(value, dict):
        return {key: canonical_json(value[key]) for key in sorted(value)}
    if isinstance(value, list):
        return [canonical_json(item) for item in value]
    return value


def command_hook_trusted_hash(event_name, matcher, command, timeout_sec,
                              status_message=None, additional_context_limit=None):
    handler = {
        "type": "command",
        "command": command,
        "timeout": timeout_sec,
        "async": False,
    }
    if status_message is not None:
        handler["statusMessage"] = status_message
    if additional_context_limit is not None:
        handler["additionalContextLimit"] = additional_context_limit
    identity = {
        "event_name": hook_event_key_label(event_name),
        "hooks": [handler],
    }
    if matcher is not None:
        identity["matcher"] = matcher
    serialized = json.dumps(canonical_json(identity), separators=(",", ":"), ensure_ascii=False)
    return "sha256:" + hashlib.sha256(serialized.encode()).hexdigest()


def toml_quote_key(key):
    return key.replace("\\", "\\\\").replace('"', '\\"')


def upsert_trusted_hash_text(text, hook_key, trusted_hash):
    section = f'[hooks.state."{toml_quote_key(hook_key)}"]'
    trusted_line = f'trusted_hash = "{trusted_hash}"\n'
    lines = text.splitlines(keepends=True)
    out = []
    i = 0
    found = False
    while i < len(lines):
        line = lines[i]
        out.append(line)
        if line.strip() == section:
            found = True
            i += 1
            replaced = False
            while i < len(lines):
                nxt = lines[i]
                if nxt.startswith("["):
                    break
                if not replaced and nxt.lstrip().startswith("trusted_hash = "):
                    out.append(trusted_line)
                    replaced = True
                    i += 1
                    continue
                out.append(nxt)
                i += 1
            if not replaced:
                out.append(trusted_line)
            continue
        i += 1
    if not found:
        if out and out[-1].strip():
            out.append("\n")
        out.append(section + "\n")
        out.append(trusted_line)
    return "".join(out)


def install_codex_hook_trusts(config_path, trust_updates):
    text = ""
    if os.path.exists(config_path):
        with open(config_path) as f:
            text = f.read()
    for hook_key, trusted_hash in trust_updates:
        text = upsert_trusted_hash_text(text, hook_key, trusted_hash)
    os.makedirs(os.path.dirname(config_path), exist_ok=True)
    tmp = config_path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
        if text and not text.endswith("\n"):
            f.write("\n")
    os.replace(tmp, config_path)

CC_LENS_MARK = "cc-lens"


def cmd_install(argv):
    import shlex
    import time as _time
    if not argv or argv[0] != "codex":
        print("usage: cclens install codex   (Claude Code side installs via /plugin)")
        sys.exit(1)
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    py = "python3"
    ours = {
        "PreToolUse": {"matcher": "apply_patch|Write|Edit",
                       "command": f"{py} {shlex.quote(os.path.join(root, 'scripts', 'snapshot.py'))}"},
        "Stop": {"matcher": None,
                 "command": f"{py} {shlex.quote(os.path.join(root, 'scripts', 'notes.py'))}"},
        "SessionStart": {"matcher": "startup",
                         "command": f"{py} {shlex.quote(os.path.join(root, 'bin', 'cclens'))} handoff --launch-hook"},
    }
    path = os.path.join(HOME, ".codex", "hooks.json")
    config_path = os.path.join(HOME, ".codex", "config.toml")
    doc = {"hooks": {}}
    if os.path.exists(path):
        with open(path) as f:
            doc = json.load(f)  # malformed file -> loud failure, we won't clobber it
        shutil_copy = path + ".bak-cc-lens-" + _time.strftime("%Y%m%dT%H%M%S")
        with open(shutil_copy, "w") as f:
            json.dump(doc, f, indent=2)
        print(dim(f"backed up existing hooks.json -> {shutil_copy}"))
    hooks = doc.setdefault("hooks", {})
    trust_updates = []
    for event, spec in ours.items():
        groups = hooks.setdefault(event, [])
        # drop any stale cc-lens entries (paths change across updates), keep others'
        for g in groups:
            g["hooks"] = [h for h in g.get("hooks", [])
                          if CC_LENS_MARK not in h.get("command", "")]
        groups[:] = [g for g in groups if g.get("hooks")]
        entry = {"hooks": [{"type": "command", "command": spec["command"],
                            "timeout": 20, "statusMessage": f"cc-lens {event.lower()}"}]}
        if spec["matcher"]:
            entry["matcher"] = spec["matcher"]
        groups.append(entry)
        group_index = len(groups) - 1
        hook_key = f"{path}:{hook_event_key_label(event)}:{group_index}:0"
        trusted_hash = command_hook_trusted_hash(
            event,
            spec["matcher"],
            spec["command"],
            20,
            f"cc-lens {event.lower()}",
        )
        trust_updates.append((hook_key, trusted_hash))
    tmp = path + ".tmp"
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(tmp, "w") as f:
        json.dump(doc, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)
    install_codex_hook_trusts(config_path, trust_updates)
    print(green("✔") + f" cc-lens hooks merged into {path}")
    print("  trusted current cc-lens hook hashes in " + bold(config_path) + ".")
    print("  next: add " + bold('eval "$(\"$HOME/cc-lens/bin/cclens\" shell-init)"')
          + " to your shell rc if you want the pre-launch chooser on plain `codex`.")
    print("  uninstall: re-run this after deleting cc-lens, or remove entries whose "
          "command contains 'cc-lens'.")


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    if "--color" in args:
        global USE_COLOR
        USE_COLOR = True
        args = [a for a in args if a != "--color"]
    cmd, rest = args[0], args[1:]
    if cmd == "sessions":
        cmd_sessions(rest)
    elif cmd == "diff":
        cmd_diff(rest)
    elif cmd == "handoff":
        cmd_handoff(rest)
    elif cmd == "import":
        cmd_import(rest)
    elif cmd == "current":
        cmd_current(rest)
    elif cmd == "launch":
        cmd_launch(rest)
    elif cmd == "shell-init":
        cmd_shell_init(rest)
    elif cmd == "install":
        cmd_install(rest)
    else:
        print(f"unknown command: {cmd}\n\n{__doc__.strip()}")
        sys.exit(1)


if __name__ == "__main__":
    main()
